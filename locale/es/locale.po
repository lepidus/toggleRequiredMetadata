msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Alternar los metadatos requeridos"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "Permite que una revista, editorial o servidor exija la afiliación, el resumen biográfico y el ORCID iD de los colaboradores de un envío. No se exige nada hasta que se elija en la configuración del módulo."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Seleccione los metadatos que se exigirán a los colaboradores de un envío:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Afiliación"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Resumen Biográfico"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.status"
msgstr "ORCID habilitado"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.effect.submission"
msgstr "Al menos un colaborador debe tener el ORCID iD verificado, y a los demás se les debe haber solicitado la verificación de ORCID, para finalizar el envío."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.status"
msgstr "ORCID no habilitado"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.effect"
msgstr "La opción ORCID está desactivada y no se puede cambiar: los colaboradores solo pueden proporcionar un ORCID iD cuando ORCID está habilitado en la configuración de ORCID. La elección guardada se mantiene y vuelve a aplicarse en cuanto se habilite ORCID."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.summary"
msgstr "ORCID iD — {$verified} de {$total} colaboradores verificados"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.rule"
msgstr "Basta un iD verificado para finalizar el envío, pero la verificación debe haberse solicitado a todos los colaboradores."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.verified"
msgstr "verificado"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.awaitingVerification"
msgstr "verificación solicitada — esperando a que abra el enlace del correo"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.notRequested"
msgstr "ninguna solicitud de verificación pendiente — edite a este colaborador y use \"Solicitar verificación\" en el campo ORCID"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.unverifiedOrcid"
msgstr "hay un iD sin verificar guardado — edite a este colaborador, elimine el iD en el campo ORCID y luego use \"Solicitar verificación\""

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.declined"
msgstr "rechazó la autorización en ORCID — para solicitarla de nuevo, edite a este colaborador y use \"Reenviar el correo electrónico de verificación\" en el campo ORCID"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "El campo \"Afiliación\" es obligatorio para todos los colaboradores"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "El campo \"Resumen biográfico\" es obligatorio para todos los colaboradores"


msgid "plugins.generic.toggleRequiredMetadata.contributorForm.affiliationRequired"
msgstr "Afiliaciones: obligatorio."

msgid "plugins.generic.toggleRequiredMetadata.contributorForm.orcidRequired"
msgstr "ORCID iD: obligatorio. Todo colaborador debe al menos tener la verificación solicitada."

msgid "plugins.generic.toggleRequiredMetadata.contributor.error.orcidVerificationData"
msgstr "Este dato solo lo define la verificación de ORCID y no puede modificarse en el colaborador."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.notRequested"
msgstr "No hay ninguna solicitud de verificación del ORCID iD pendiente para: {$pendingAuthors}. Para solicitarla, edite el colaborador y use \"Solicitar verificación\" en el campo ORCID."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.unverifiedOrcid"
msgstr "Hay un ORCID iD nunca verificado guardado para: {$pendingAuthors}, y debe quitarse antes de poder solicitar la verificación. Edite el colaborador, elimine el iD sin verificar en el campo ORCID y luego use \"Solicitar verificación\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.awaitingVerification"
msgstr "Esperando la verificación del ORCID iD de: {$pendingAuthors}. La verificación fue solicitada, y el iD solo se confirma cuando el colaborador abre el enlace del correo electrónico, que puede tardar unos minutos en salir. Si no lo recibió, edite el colaborador y use \"Reenviar el correo electrónico de verificación\" en el campo ORCID — el reenvío invalida el enlace anterior."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.notRequested"
msgstr "No hay ninguna solicitud de verificación del ORCID iD pendiente para: {$pendingAuthors}. Si puede editar los colaboradores, use \"Solicitar verificación\" en su campo ORCID; de lo contrario, solicite a la revista que la pida."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.unverifiedOrcid"
msgstr "Hay un ORCID iD nunca verificado guardado para: {$pendingAuthors}. Si puede editar los colaboradores, elimine el iD sin verificar en su campo ORCID y luego use \"Solicitar verificación\"; de lo contrario, solicite a la revista que lo haga."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.awaitingVerification"
msgstr "Esperando la verificación del ORCID iD de: {$pendingAuthors}. La verificación fue solicitada, y el iD solo se confirma cuando el colaborador abre el enlace del correo electrónico, que puede tardar unos minutos en salir. Pídale que busque el correo electrónico más reciente, incluso en la carpeta de spam, ya que solo su enlace funciona, o solicite a la revista que lo envíe de nuevo."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.declined"
msgstr "La autorización ORCID fue rechazada por: {$pendingAuthors}. Para solicitarla de nuevo, edite el colaborador y use \"Reenviar el correo electrónico de verificación\" en el campo ORCID."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.declined"
msgstr "La autorización ORCID fue rechazada por: {$pendingAuthors}. Si finalmente quieren verificar su iD, solicite a la revista que envíe de nuevo el correo electrónico de verificación."
