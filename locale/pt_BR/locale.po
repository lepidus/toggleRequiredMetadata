msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Alternar metadados obrigatórios"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "Permite que uma revista, editora ou servidor exija a afiliação, o resumo da biografia e o ORCID iD dos contribuidores de uma submissão. Nada é exigido até ser escolhido nas configurações do plugin."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Selecione os campos para se tornarem de preenchimento obrigatório pelos autores de uma submissão:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Afiliação"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Resumo da Biografia"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.status"
msgstr "Plugin Perfil ORCID ativo"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.field"
msgstr "O campo ORCID fica sob controle do plugin Perfil ORCID."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.submission"
msgstr "Pelo menos um coautor precisa ter o ORCID iD autenticado, e os demais precisam ter recebido a solicitação de autorização, para concluir a submissão."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.warning"
msgstr "Enquanto a exigência não for cumprida, o fluxo editorial de uma submissão não publicada nomeia os contribuidores que ainda a seguram."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.orcid"
msgstr "O campo \"ORCID\" é requerido para todos os coautores"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.noAuthenticatedOrcid"
msgstr "Pelo menos um dos coautores precisa ter o ORCID iD autenticado. O coautor autentica o dele abrindo o link de autorização enviado por e-mail."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.orcidAuthorization"
msgstr "A solicitação de autorização ORCID não foi enviada para: {$pendingAuthors}. Edite este(s) coautor(es) e marque \"Enviar e-mail para solicitar autorização ORCID do contribuidor\", para que recebam o link de autorização."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "O campo \"Afiliação\" é requerido para todos os coautores"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "O campo \"Resumo da Biografia\" é requerido para todos os coautores"

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.notRequested"
msgstr "A autorização ORCID ainda não foi solicitada a: {$pendingAuthors}. Para solicitá-la, acesse a aba Publicação, edite o contribuidor e marque \"Enviar e-mail para solicitar autorização ORCID do contribuidor\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.awaitingAuthorization"
msgstr "Aguardando a autorização ORCID de: {$pendingAuthors}. O e-mail de autorização foi enviado, e o ORCID iD só é autenticado quando o contribuidor abre o link contido nele. Para enviá-lo novamente, acesse a aba Publicação, edite o contribuidor e marque \"Enviar e-mail para solicitar autorização ORCID do contribuidor\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.notRequested"
msgstr "A autorização ORCID ainda não foi solicitada a: {$pendingAuthors}. Se você puder editar os contribuidores, marque \"Enviar e-mail para solicitar autorização ORCID do contribuidor\" em cada um; caso contrário, peça à revista que a solicite."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.awaitingAuthorization"
msgstr "Aguardando a autorização ORCID de: {$pendingAuthors}. O ORCID iD só é autenticado depois que o contribuidor abre o link de autorização enviado por e-mail. Peça a eles que procurem esse e-mail, inclusive na caixa de spam, ou solicite à revista o reenvio da solicitação."
