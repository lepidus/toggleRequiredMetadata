msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Alternar metadados obrigatórios"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "Permite que uma revista, editora ou servidor exija a afiliação, o resumo da biografia e o ORCID iD dos contribuidores de uma submissão. Nada é exigido até ser escolhido nas configurações do plugin."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Selecione os metadados a serem exigidos dos contribuidores de uma submissão:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Afiliação"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Resumo da Biografia"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.status"
msgstr "ORCID habilitado"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.effect.submission"
msgstr "Pelo menos um coautor precisa ter o ORCID iD verificado, e os demais precisam ter recebido a solicitação de verificação, para concluir a submissão."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.status"
msgstr "ORCID não habilitado"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.effect"
msgstr "A opção ORCID está desativada e não pode ser alterada: os contribuidores só podem informar um ORCID iD quando o ORCID está habilitado nas configurações de ORCID. A escolha salva é preservada e volta a valer assim que o ORCID for habilitado."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.summary"
msgstr "ORCID iD — {$verified} de {$total} coautores verificados"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.rule"
msgstr "Basta um iD verificado para concluir a submissão, mas a verificação precisa ter sido solicitada a todos os coautores."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.verified"
msgstr "verificado"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.awaitingVerification"
msgstr "e-mail enviado — aguardando que ele abra o link de verificação"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.notRequested"
msgstr "nenhum pedido de verificação pendente — edite este coautor e use \"Solicitar verificação\" no campo ORCID"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.unverifiedOrcid"
msgstr "há um iD não verificado salvo — edite este coautor, exclua o iD no campo ORCID e então use \"Solicitar verificação\""

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.declined"
msgstr "recusou a autorização no ORCID — para pedir de novo, edite este coautor e use \"Reenviar e-mail de verificação\" no campo ORCID"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.noPendingLink"
msgstr "solicitado, mas não há link de verificação pendente — edite este coautor e use \"Reenviar e-mail de verificação\" no campo ORCID"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "O campo \"Afiliação\" é requerido para todos os coautores"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "O campo \"Resumo da Biografia\" é requerido para todos os coautores"


msgid "plugins.generic.toggleRequiredMetadata.contributorForm.affiliationRequired"
msgstr "Afiliações: obrigatório."

msgid "plugins.generic.toggleRequiredMetadata.contributorForm.orcidRequired"
msgstr "ORCID iD: obrigatório. Todo coautor precisa ao menos ter a verificação solicitada."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.notRequested"
msgstr "Não há pedido de verificação do ORCID iD pendente para: {$pendingAuthors}. Para solicitar, edite o contribuidor e use \"Solicitar verificação\" no campo ORCID."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.unverifiedOrcid"
msgstr "Há um ORCID iD nunca verificado salvo para: {$pendingAuthors}, e ele precisa sair antes que a verificação possa ser solicitada. Edite o contribuidor, exclua o iD não verificado no campo ORCID e então use \"Solicitar verificação\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.awaitingVerification"
msgstr "Aguardando a verificação do ORCID iD de: {$pendingAuthors}. O e-mail de verificação foi enviado, e o iD só é confirmado quando o contribuidor abre o link contido nele. Para enviar o e-mail novamente, edite o contribuidor e use \"Reenviar e-mail de verificação\" no campo ORCID — o reenvio invalida o link anterior."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.notRequested"
msgstr "Não há pedido de verificação do ORCID iD pendente para: {$pendingAuthors}. Se você puder editar os contribuidores, use \"Solicitar verificação\" no campo ORCID deles; caso contrário, peça à revista que a solicite."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.unverifiedOrcid"
msgstr "Há um ORCID iD nunca verificado salvo para: {$pendingAuthors}. Se você puder editar os contribuidores, exclua o iD não verificado no campo ORCID deles e então use \"Solicitar verificação\"; caso contrário, peça à revista que faça isso."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.awaitingVerification"
msgstr "Aguardando a verificação do ORCID iD de: {$pendingAuthors}. O e-mail de verificação foi enviado, e o iD só é confirmado quando o contribuidor abre o link contido nele. Peça a ele que procure o e-mail mais recente, inclusive na caixa de spam, pois só esse link funciona, ou solicite à revista o reenvio."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.noPendingLink"
msgstr "A verificação do ORCID iD foi solicitada a {$pendingAuthors}, mas não há link de verificação pendente, então ela não pode ser concluída: o e-mail pode não ter sido enviado, ou o iD foi removido depois de verificado. Edite o contribuidor e use \"Reenviar e-mail de verificação\" no campo ORCID."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.declined"
msgstr "A autorização ORCID foi recusada por: {$pendingAuthors}. Para pedir de novo, edite o contribuidor e use \"Reenviar e-mail de verificação\" no campo ORCID."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.noPendingLink"
msgstr "A verificação do ORCID iD foi solicitada a {$pendingAuthors}, mas não há link de verificação pendente, então ela não pode ser concluída. Peça à revista que envie o e-mail de verificação novamente."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.declined"
msgstr "A autorização ORCID foi recusada por: {$pendingAuthors}. Se quiserem verificar o iD afinal, peça à revista que envie o e-mail de verificação novamente."
