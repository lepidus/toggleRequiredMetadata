msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Toggle required metadata"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "This plugin allows to make the \"affiliation\" and \"ORCID\" fields required for the submissions authors to fill in."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Select the fields to be required for the submissions authors to fill:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Affiliation"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Biography Statement"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.status"
msgstr "ORCID Profile plugin enabled"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.field"
msgstr "The ORCID field stays under the ORCID Profile plugin's control."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.submission"
msgstr "At least one contributor must have an authenticated ORCID iD, and the ORCID authorization must have been requested from the others, to finish a submission."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.warning"
msgstr "The workflow names the contributors who have not authenticated yet."

msgid "plugins.generic.toggleRequiredMetadata.error"
msgstr "Please enter your author's Biography Statement."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.contributors"
msgstr "Required contributor information is missing. The details are listed next to the contributors."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.orcid"
msgstr "The ORCID field is required for all contributors. "

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.noAuthenticatedOrcid"
msgstr "At least one contributor must have an authenticated ORCID iD. Contributors authenticate theirs by opening the authorization link sent by e-mail."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.orcidAuthorization"
msgstr "The ORCID authorization has not been requested from: {$pendingAuthors}. Edit the contributor(s) and tick \"Send e-mail to request ORCID authorization from contributor\", so that they receive the authorization link."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "The affiliation field is required for all contributors. "

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "The biography statement field is required for all contributors. "

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.orcidWarning"
msgstr "ORCID iD not authenticated yet by: {$pendingAuthors}. The authentication is only completed once the contributor opens the authorization link sent by e-mail, and until then the ORCID iD on record is not confirmed. To send this request, go to the Publication tab, edit the contributor and tick \"Send e-mail to request ORCID authorization from contributor\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.orcidWarning"
msgstr "ORCID iD not authenticated yet by: {$pendingAuthors}. The ORCID iD is only confirmed after the contributor opens the authorization link sent by e-mail. Ask them to look for this e-mail, including in the spam folder, or ask the journal to send the request again."
