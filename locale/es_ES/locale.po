msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Alternar los metadatos requeridos"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "Este módulo permite hacer que los campos \"afiliación\" y \"ORCID\" sean obligatorios para los autores de un envío."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Seleccione los campos que serán obligatorios para los autores de un envío:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Afiliación"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Resumen Biográfico"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.status"
msgstr "Módulo Perfil ORCID activo"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.field"
msgstr "El campo ORCID queda bajo control del módulo Perfil ORCID."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.submission"
msgstr "Cada colaborador necesita el ORCID iD autenticado, o la solicitud de autorización enviada, para finalizar el envío."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcidProfile.effect.warning"
msgstr "El flujo editorial nombra a quienes aún no se han autenticado."

msgid "plugins.generic.toggleRequiredMetadata.error"
msgstr "Por favor ingrese lo Resumen biográfico de su autor."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.contributors"
msgstr "Faltan datos obligatorios de los colaboradores. Los detalles se enumeran junto a la lista de colaboradores."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.orcid"
msgstr "El campo \"ORCID\" es obligatorio para todos los colaboradores. "

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.orcidAuthorization"
msgstr "La autorización ORCID no se ha iniciado para todos los colaboradores. Edite cada colaborador pendiente y marque \"Enviar correo electrónico para solicitar autorización ORCID del colaborador\", para que reciba el enlace de autorización. Los colaboradores que ya han autenticado su ORCID iD no lo necesitan."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "El campo \"Afiliación\" es obligatorio para todos los colaboradores. "

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "El campo \"Resumen biográfico\" es obligatorio para todos los colaboradores. "

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.orcidWarning"
msgstr "ORCID iD aún no autenticado por: {$pendingAuthors}. La autenticación solo se completa cuando el colaborador abre el enlace de autorización enviado por correo electrónico y, hasta entonces, el ORCID iD registrado no está confirmado. Para enviar esa solicitud, vaya a la pestaña Publicación, edite el colaborador y marque \"Enviar correo electrónico para solicitar autorización ORCID del colaborador\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.orcidWarning"
msgstr "ORCID iD aún no autenticado por: {$pendingAuthors}. El ORCID iD solo se confirma después de que el colaborador abre el enlace de autorización enviado por correo electrónico. Pídales que busquen ese correo electrónico, incluso en la carpeta de spam, o solicite a la revista el envío de la solicitud."
