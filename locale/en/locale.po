msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Toggle required metadata"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "This plugin makes the affiliation, the biography statement and the ORCID iD of the contributors required in a submission."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Select the metadata to be required from the contributors of a submission:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Affiliation"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Biography Statement"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.status"
msgstr "ORCID enabled"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.effect.submission"
msgstr "At least one contributor must have a verified ORCID iD, and the ORCID verification must have been requested from the others, to finish a submission."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.status"
msgstr "ORCID not enabled"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.effect"
msgstr "The ORCID option is turned off and cannot be changed: contributors can only provide an ORCID iD once ORCID is enabled in the ORCID settings. The saved choice is kept, and applies again as soon as ORCID is enabled."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.summary"
msgstr "ORCID iD — {$verified} of {$total} contributors verified"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.rule"
msgstr "One verified iD is enough to finish the submission, but the verification must have been requested from every contributor."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.verified"
msgstr "verified"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.awaitingVerification"
msgstr "e-mail sent — waiting for them to open the verification link"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.notRequested"
msgstr "not requested yet — edit this contributor and use \"Request verification\" on the ORCID field"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "The affiliation field is required for all contributors"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "The biography statement field is required for all contributors"


msgid "plugins.generic.toggleRequiredMetadata.contributorForm.affiliationRequired"
msgstr "Affiliations: required."

msgid "plugins.generic.toggleRequiredMetadata.contributorForm.orcidRequired"
msgstr "ORCID iD: required. Every contributor must at least have the verification requested."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.pendingVerification"
msgstr "Waiting for the ORCID iD verification of: {$pendingAuthors}. The verification e-mail was already sent, and the iD is only confirmed once the contributor opens the link in it. To send the e-mail again, edit the contributor and use \"Resend Verification Email\" on the ORCID field."


msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.pendingVerification"
msgstr "Waiting for the ORCID iD verification of: {$pendingAuthors}. The verification e-mail was already sent, and the iD is only confirmed once the contributor opens the link in it. Ask them to look for this e-mail, including in the spam folder, or ask the journal to send it again."

