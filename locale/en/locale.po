msgid "plugins.generic.toggleRequiredMetadata.displayName"
msgstr "Toggle required metadata"

msgid "plugins.generic.toggleRequiredMetadata.description"
msgstr "Lets a journal, press or server require the affiliation, the biography statement and the ORCID iD of the contributors of a submission. Nothing is required until it is chosen in the plugin settings."

msgid "plugins.generic.toggleRequiredMetadata.settings.description"
msgstr "Select the metadata to be required from the contributors of a submission:"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireOrcid"
msgstr "ORCID"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireAffiliation"
msgstr "Affiliation"

msgid "plugins.generic.toggleRequiredMetadata.settings.requireBiography"
msgstr "Biography Statement"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.status"
msgstr "ORCID enabled"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.enabled.effect.submission"
msgstr "At least one contributor must have a verified ORCID iD, and the ORCID verification must have been requested from the others, to finish a submission."

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.status"
msgstr "ORCID not enabled"

msgid "plugins.generic.toggleRequiredMetadata.settings.orcid.disabled.effect"
msgstr "The ORCID option is turned off and cannot be changed: contributors can only provide an ORCID iD once ORCID is enabled in the ORCID settings. The saved choice is kept, and applies again as soon as ORCID is enabled."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.summary"
msgstr "ORCID iD — {$verified} of {$total} contributors verified"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.rule"
msgstr "One verified iD is enough to finish the submission, but the verification must have been requested from every contributor."

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.verified"
msgstr "verified"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.awaitingVerification"
msgstr "verification requested — waiting for them to open the link in the e-mail"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.notRequested"
msgstr "no verification request pending — edit this contributor and use \"Request verification\" on the ORCID field"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.unverifiedOrcid"
msgstr "an unverified iD is stored — edit this contributor, delete the iD on the ORCID field, then use \"Request verification\""

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.orcid.status.declined"
msgstr "declined the authorization in ORCID — to ask again, edit this contributor and use \"Resend Verification Email\" on the ORCID field"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.affiliation"
msgstr "The affiliation field is required for all contributors"

msgid "plugins.generic.toggleRequiredMetadata.stepValidation.error.biography"
msgstr "The biography statement field is required for all contributors"


msgid "plugins.generic.toggleRequiredMetadata.contributorForm.affiliationRequired"
msgstr "Affiliations: required."

msgid "plugins.generic.toggleRequiredMetadata.contributorForm.orcidRequired"
msgstr "ORCID iD: required. Every contributor must at least have the verification requested."

msgid "plugins.generic.toggleRequiredMetadata.contributor.error.orcidVerificationData"
msgstr "This is only set by the ORCID verification and cannot be changed for a contributor."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.notRequested"
msgstr "No ORCID iD verification request is pending for: {$pendingAuthors}. To request one, edit the contributor and use \"Request verification\" on the ORCID field."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.unverifiedOrcid"
msgstr "An ORCID iD that was never verified is stored for: {$pendingAuthors}, and it has to go before the verification can be requested. Edit the contributor, delete the unverified iD on the ORCID field, then use \"Request verification\"."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.awaitingVerification"
msgstr "Waiting for the ORCID iD verification of: {$pendingAuthors}. The verification was requested, and the iD is only confirmed once the contributor opens the link in the e-mail, which can take a few minutes to go out. If they did not get it, edit the contributor and use \"Resend Verification Email\" on the ORCID field, which invalidates the previous link."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.notRequested"
msgstr "No ORCID iD verification request is pending for: {$pendingAuthors}. If you can edit the contributors, use \"Request verification\" on their ORCID field; otherwise, ask the journal to request it."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.unverifiedOrcid"
msgstr "An ORCID iD that was never verified is stored for: {$pendingAuthors}. If you can edit the contributors, delete the unverified iD on their ORCID field and then use \"Request verification\"; otherwise, ask the journal to do it."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.awaitingVerification"
msgstr "Waiting for the ORCID iD verification of: {$pendingAuthors}. The verification was requested, and the iD is only confirmed once the contributor opens the link in the e-mail, which can take a few minutes to go out. Ask them to look for the most recent e-mail, including in the spam folder, since only its link works, or ask the journal to send it again."

msgid "plugins.generic.toggleRequiredMetadata.notification.workflow.declined"
msgstr "The ORCID authorization was declined by: {$pendingAuthors}. To ask again, edit the contributor and use \"Resend Verification Email\" on the ORCID field."

msgid "plugins.generic.toggleRequiredMetadata.notification.authorDashboard.declined"
msgstr "The ORCID authorization was declined by: {$pendingAuthors}. If they want to verify their iD after all, ask the journal to send the verification e-mail again."
